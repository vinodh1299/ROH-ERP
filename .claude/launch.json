{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "BACK-END",
        "start"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd FRONT-END && flutter build web && cd .. && node BACK-END/web_server.js"
      ],
      "port": 8080
    }
  ]
}
